acl "trusted" {
    10.1.0.0/16;
    127.0.0.0/8;
};

options {
    directory "/var/cache/bind";

    listen-on { any; };
    listen-on-v6 { any; };

    recursion yes;
    allow-query     { trusted; };
    allow-recursion { trusted; };

    forwarders {
        1.1.1.1;
        8.8.8.8;
    };
    forward only;

    dnssec-validation auto;
    auth-nxdomain no;
};