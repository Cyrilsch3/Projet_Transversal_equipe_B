# A mettre dans /etc/bind/named.conf.options
acl "trusted" {
    10.1.0.0/16;   # On autorise tout le réseau interne
    127.0.0.0/8;
};

options {
    directory "/var/cache/bind";
    recursion yes;
    allow-query { trusted; };
    
    # C'est ici qu'on fait le pont avec Internet
    forwarders {
        1.1.1.1;
        8.8.8.8;
    };
    
    dnssec-validation auto;
    listen-on-v6 { any; };
};