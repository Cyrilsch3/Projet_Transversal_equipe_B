// Zone Directe (Noms -> IP)
zone "grp-b.ephec-ti.be" {
    type master;
    file "/etc/bind/db.grp-b.ephec-ti.be";
};

// Zone Inverse (IP -> Noms) pour le réseau 10.1.20.0/24
// Attention : Ici il faut écrire l'IP à l'envers
zone "20.1.10.in-addr.arpa" {
    type master;
    file "/etc/bind/db.10.1.20";
};